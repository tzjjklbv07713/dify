    "configurate_methods": [
      "predefined-model",
      "customizable-model"
    ],
    "provider_credential_schema": {
      "credential_form_schemas": [
        {
          "variable": "proxy_base_url",
          "label": {
            "en_US": "Proxy Base URL",
            "zh_Hans": "Proxy Base URL"
          },
          "type": "text-input",
          "required": true,
          "placeholder": {
            "en_US": "https://model-hub.example.com",
            "zh_Hans": "https://model-hub.example.com"
          }
        },
        {
          "variable": "proxy_api_key",
          "label": {
            "en_US": "Proxy API Key",
            "zh_Hans": "Proxy API Key"
          },
          "type": "secret-input",
          "required": true
        },
        {
          "variable": "catalog_path",
          "label": {
            "en_US": "Catalog Path",
            "zh_Hans": "Catalog Path"
          },
          "type": "text-input",
          "required": false,
          "default": "/provider/models",
          "placeholder": {
            "en_US": "/provider/models",
            "zh_Hans": "/provider/models"
          }
        },
        {
          "variable": "api_protocol",
          "label": {
            "en_US": "API Protocol",
            "zh_Hans": "API Protocol"
          },
          "type": "select",
          "required": false,
          "default": "responses",
          "options": [
            {
              "value": "responses",
              "label": {
                "en_US": "Responses API",
                "zh_Hans": "Responses API"
              }
            },
            {
              "value": "chat_completions",
              "label": {
                "en_US": "Chat Completions",
                "zh_Hans": "Chat Completions"
              }
            }
          ]
        },
        {
          "variable": "routing_group",
          "label": {
            "en_US": "Routing Group",
            "zh_Hans": "Routing Group"
          },
          "type": "text-input",
          "required": false
        },
        {
          "variable": "timeout_ms",
          "label": {
            "en_US": "Timeout (ms)",
            "zh_Hans": "Timeout (ms)"
          },
          "type": "text-input",
          "required": false,
          "default": "15000"
        },
        {
          "variable": "validation_model",
          "label": {
            "en_US": "Validation Model",
            "zh_Hans": "Validation Model"
          },
          "type": "text-input",
          "required": false
        }
      ]
    },
    "model_credential_schema": {
      "model": {
        "label": {
