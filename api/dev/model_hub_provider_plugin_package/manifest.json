    "provider_name": "model-hub",
    "label": {
      "en_US": "Model Hub",
      "zh_Hans": "Model Hub"
    },
    "description": {
      "en_US": "Third-party proxy provider with remote model discovery and manual model fallback.",
      "zh_Hans": "Third-party proxy provider with remote model discovery and manual model fallback."
    },
    "icon_small": {
      "en_US": "_assets/model-hub-icon.svg",
      "zh_Hans": "_assets/model-hub-icon.svg"
    },
    "icon_small_dark": {
